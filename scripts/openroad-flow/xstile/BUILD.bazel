# XSTile on ASAP7: the implied 4-macro zero-glue floorplan & dissolve flow.
#
# The flows are manual and run by hand; `bazelisk build //...` builds only
# the small tests beside them.

load("@bazel-orfs//:openroad.bzl", "odb_debug", "orfs_run", "orfs_schedule")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":plan/plan.bzl", "PLAN")
load(":xiangshan.bzl", "xiangshan_flow")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "Backend_macros.tcl",
    "anneal_in_flow.tcl",
    "constraints.sdc",
    "fold_entries.tcl",
    "global_place_args.tcl",
    "gpl_clusters.json",
    "gpl_clusters_backend.json",
    "kpi_run.tcl",
    "legalize_out_of_blocks.tcl",
    "plan/plan.bzl",
    "plan/plan.json",
    "xs_icg.ys",
    "xs_icg_map.v",
] + glob(["*.regfile"]))

xiangshan_flow(
    name = "XSTile",
    plan = PLAN,
)

# All 4 real blocks MUST pass gpl_driven.sh (timing- and routability-driven GPL).
# XSTile_parent holds only the 7 IntBuffer flip-flops with DONT_BUFFER_PORTS=1.
GPL_DRIVEN_PARTS = sorted(PLAN["macros"].keys())

[
    filegroup(
        name = "%s_3_3_place_gp.log" % part,
        srcs = [":%s_place" % part],
        output_group = "3_3_place_gp.log",
        tags = ["manual"],
    )
    for part in GPL_DRIVEN_PARTS
]

[
    genrule(
        name = "%s_gpl_driven" % part,
        srcs = [":%s_3_3_place_gp.log" % part],
        outs = ["%s_gpl_driven.txt" % part],
        cmd = "$(execpath :gpl_driven.sh) %s $< $@" % part,
        tags = ["manual"],
        tools = [":gpl_driven.sh"],
    )
    for part in GPL_DRIVEN_PARTS
]

sh_test(
    name = "gpl_driven_test",
    size = "small",
    srcs = ["gpl_driven_test.sh"],
    args = [
        "$(rootpath :gpl_driven.sh)",
        "$(rootpath gpl_driven_logs/parent.log)",
        "$(rootpath gpl_driven_logs/no_routability.log)",
        "$(rootpath gpl_driven_logs/no_timing.log)",
    ],
    data = [
        "gpl_driven.sh",
        "gpl_driven_logs/no_routability.log",
        "gpl_driven_logs/no_timing.log",
        "gpl_driven_logs/parent.log",
    ],
)

orfs_schedule(
    name = "build",
    macros = {
        block: [
            ":%s_kpi" % block,
            ":%s_generate_abstract" % block,
            ":%s_gpl_driven" % block,
        ]
        for block in sorted(PLAN["macros"].keys())
    } | {
        "XSTile_parent": [
            ":XSTile_parent_grt",
            ":XSTile_parent_abstract",
            ":XSTile_parent_kpi",
        ],
    },
    parent = {"XSTile_parent_pm": [
        ":XSTile_parent_pm_firm_top",
        ":XSTile_parent_pm_firm_crossings",
    ]},
    tags = ["manual"],
)

# Compact helper summaries (< 64 KiB) for inspecting Backend's 5 regfile LEF
# outlines and synthesized instance paths without reading large build outputs.
genrule(
    name = "regfile_sizes",
    srcs = [
        ":FpRegFile_generate_abstract",
        ":IntRegFile_generate_abstract",
        ":RenameBufferFile_generate_abstract",
        ":RobEntryFile_generate_abstract",
        ":VfRegFile_generate_abstract",
    ],
    outs = ["regfile_sizes.txt"],
    cmd = "for f in $(SRCS); do case \"$$f\" in *.lef) grep -E '^(MACRO |  SIZE )' \"$$f\";; esac; done > $@",
    tags = ["manual"],
)

orfs_run(
    name = "Backend_macro_insts",
    src = ":Backend_synth",
    outs = ["Backend_macro_insts.txt"],
    script = ":probe_backend_macros.tcl",
    tags = ["manual"],
    user_arguments = {"PROBE_OUT": "$(location Backend_macro_insts.txt)"},
)

[
    odb_debug(
        name = "XSTile_%s_odb_debug" % stage,
        src = ":XSTile_" + stage,
        tags = ["manual"],
    )
    for stage in [
        "synth",
        "place",
        "cts",
        "grt",
    ]
]

[
    odb_debug(
        name = "%s_%s_odb_debug" % (block, stage),
        src = ":%s_%s" % (block, stage),
        tags = ["manual"],
    )
    for block in PLAN["macros"].keys()
    for stage in [
        "synth",
        "place",
        "grt",
    ]
]

genrule(
    name = "XSTile_boundary_constants",
    srcs = [
        "//scripts/openroad-flow/verilog:xiangshan_flat",
        "plan/plan.json",
        "plan/plan.bzl",
    ],
    outs = ["XSTile_boundary_constants.json"],
    cmd = "$(execpath @bazel-orfs//tools/boundary_constants) " +
          "$(location //scripts/openroad-flow/verilog:xiangshan_flat) --top XSTile " +
          "--plan $(location plan/plan.json) --plan-bzl $(location plan/plan.bzl) --out $@",
    tags = ["manual"],
    tools = ["@bazel-orfs//tools/boundary_constants"],
)
