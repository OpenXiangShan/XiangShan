        # Extracted from //patches:0246-opensta-filtered-search-overlay.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0246-opensta-filtered-search-overlay.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0246-opensta-filtered-search-overlay.patch.' && exit 1)",
