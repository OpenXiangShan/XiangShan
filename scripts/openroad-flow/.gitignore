# Bazel's convenience links (not bazel-orfs-patches/) and scratch space
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-openroad-flow
/tmp/
/user.bazelrc
MODULE.bazel.lock

# What `bazelisk run @bazel-orfs//:agent -- setup` and its session hook
# write for a local agent; kept local (README.md, "For an AI agent").
/.claude/
/.mcp.json
/CLAUDE.md

# Test data: global placement logs gpl_driven_test reads (the root
# .gitignore ignores *.log)
!/xstile/gpl_driven_logs/*.log
