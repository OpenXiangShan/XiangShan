# The flags OpenROAD's and yosys's from-source builds need when they are
# dependencies (bazel-orfs's docs/openroad.md, "Root MODULE.bazel
# requirements"), and bazel-orfs's own defaults.
build --incompatible_strict_action_env
build --features=external_include_paths
build --per_file_copt=.*external/.*@-w
build --host_per_file_copt=.*external/.*@-w
build --cxxopt "-std=c++20" --host_cxxopt "-std=c++20"
build --@rules_python//python/config_settings:bootstrap_impl=script

common --lockfile_mode=off
common --@@protobuf+//bazel/toolchains:prefer_prebuilt_protoc
common --downloader_config=bazel/downloader.cfg
common --incompatible_default_to_explicit_init_py

# The default reads /usr/share/terminfo, which minimal hosts lack and
# nothing uses.
common --@ncurses//:use_terminfo_data_target=false

# Local settings, never committed: a remote cache, --jobs, a disk cache.
try-import %workspace%/user.bazelrc
