diff --git a/openroad/gpl/src/nesterovBase.cpp b/openroad/gpl/src/nesterovBase.cpp
index 8ceeb9b..c0da9a7 100644
--- a/openroad/gpl/src/nesterovBase.cpp
+++ b/openroad/gpl/src/nesterovBase.cpp
@@ -4034,6 +4034,51 @@ bool NesterovBase::isConvergenceDue() const
              && sum_overflow_unscaled_ <= npVars_->targetOverflow);
 }
 
+void NesterovBase::settleOnIterate(const int iter)
+{
+  if (isConverged_ || is_overflow_stale_
+      || sum_overflow_unscaled_ > kIterateWindow * npVars_->targetOverflow) {
+    return;
+  }
+  pullSlpFromDevice();
+
+  // The look-ahead extrapolates the cells' last move, and that move's
+  // wirelength comes on top of the iterate's. While the cells spread it is
+  // the further spread of the two and usually reaches the target overflow
+  // first; when they run away while the overflow stalls it overshoots into
+  // full bins and the iterate gets there first. Near the target, the
+  // overflow that convergence is judged by is the iterate's.
+  updateGCellDensityCenterLocation(curCoordi_);
+  const float denominator = getOverflowDenominator(iter);
+  sum_overflow_unscaled_ = getOverflowAreaUnscaled() / denominator;
+  if (sum_overflow_unscaled_ > npVars_->targetOverflow) {
+    // The next step starts from the look-ahead: put the density back on it.
+    // The overflow stays the iterate's (see the declaration).
+    updateGCellDensityCenterLocation(curSLPCoordi_);
+    return;
+  }
+
+  // The gradients stay the ones evaluated at the look-ahead: no step is
+  // taken from here. The region is at the target and converges in this
+  // iteration, unless a revert later in it (routability, divergence)
+  // replaces its state with a snapshot's.
+  curSLPCoordi_ = curCoordi_;
+  sum_overflow_ = getOverflowArea() / denominator;
+  prev_hpwl_ = nbc_->getHpwl();
+
+#ifdef ENABLE_GPU
+  if (nb_device_ctx_) {
+    nb_device_ctx_->syncCoordsToDevice(curSLPCoordi_,
+                                       prevSLPCoordi_,
+                                       curCoordi_,
+                                       curSLPSumGrads_,
+                                       prevSLPSumGrads_);
+    commitCoordsToDeviceState(SlpSlot::Cur);
+    host_coords_fresh_ = true;
+  }
+#endif
+}
+
 bool NesterovBase::checkConvergence(int gpl_iter_count,
                                     int routability_gpl_iter_count,
                                     RouteBase* rb)
