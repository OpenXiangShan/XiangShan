+// Near the target overflow an iteration measures Nesterov's iterate, and at
+// the target the region moves onto it (NesterovBase::settleOnIterate()). A
+// settle wait still open there ends by convergence (GPL-0124); pass 1, the
+// snapshot of it and the end of a phase whose minimum is that pass
+// (GPL-0125) are all of the iterate, and the placement converges on it.
+TEST_F(RoutabilityMinimumTest, FirstPassAtTargetIsTheIterate)
+{
+  // A target the iterate below reaches: on a uniform grid the overflow is
+  // about 0.12, from the bins' sampling of the cells' sizes.
+  options_.overflow = 0.2f;
+  makePlacer();
+  float current_a = 1.0f;
+  ASSERT_NO_FATAL_FAILURE(saveRoutabilitySnapshot(current_a));
+
+  // The iterate spread over the core and the look-ahead a site right of it,
+  // with the density on the look-ahead, which reads within the window above
+  // the target.
+  spreadCells();
+  const auto iterate_centers = iterateCenters();
+  ASSERT_NE(countDiffering(centers(), iterate_centers), 0)
+      << "the density must start on the look-ahead";
+  measureNearTarget(1.2f * options_.overflow);
+  ASSERT_LE(nb().getSumOverflowUnscaled(), options_.overflow)
+      << "the iterate must be at the target for the region to settle on it";
+  ASSERT_EQ(countDiffering(centers(), iterate_centers), 0)
+      << "the region must settle on its iterate";
+  const auto first_pass_cells = cellStates();
+  const RegionState first_pass_region = regionState();
+  const int64_t first_pass_hpwl = nb().getIterHpwl();
+  ASSERT_EQ(first_pass_hpwl, nbc_->getHpwl());
+  const float first_pass_overflow = nb().getSumOverflowUnscaled();
+
+  // The cells still moving: the wait that opens ends by convergence, and
+  // pass 1 runs on the iterate.
+  setDisplacementRatio(1.0f);
+  logger_.teeStringBegin();
+  ASSERT_FALSE(runIteration(kWidth, current_a));
+  ASSERT_EQ(passes_, 1);
+  ASSERT_TRUE(rb_->isMinRc());
+  ASSERT_TRUE(routabilityNeeded());
+
+  const bool converged = runPassesWithoutImprovement(current_a);
+  const std::string log = logger_.teeStringEnd();
+  ASSERT_FALSE(routabilityNeeded());
+  ASSERT_NE(log.find("GPL-0124"), std::string::npos);
+  ASSERT_NE(log.find("GPL-0054"), std::string::npos);
+  EXPECT_NE(log.find("GPL-0125"), std::string::npos);
+
+  EXPECT_EQ(countDiffering(centers(), iterate_centers), 0)
+      << "the phase must end with the density on the iterate pass 1 measured";
+  expectNesterovState(first_pass_cells, first_pass_region);
+  EXPECT_EQ(countDiffering(withoutFillers(cellStates()),
+                           withoutFillers(first_pass_cells)),
+            0);
+  EXPECT_FLOAT_EQ(nb().getSumOverflowUnscaled(), first_pass_overflow);
+  EXPECT_EQ(nb().getIterHpwl(), first_pass_hpwl);
+  EXPECT_TRUE(converged) << "the iterate pass 1 measured must converge";
+}
+
 // Above the target overflow, a phase whose minimum is its first pass goes on
