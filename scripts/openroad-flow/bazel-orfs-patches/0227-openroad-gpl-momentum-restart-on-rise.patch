@@ -703,4 +708,80 @@ INSTANTIATE_TEST_SUITE_P(Endings,
                          ::testing::Values(Ending::kNoImprovement,
                                            Ending::kBudgetSpent));
 
+// A routability pass owns the iteration it runs on: it may revert the
+// placement whose HPWL the iteration measured, or resize its cells, so the
+// momentum restart on an HPWL rise (NesterovPlace::restartMomentumOnRise())
+// stands aside there, and the next iteration measures its own rise. A whole
+// routability-driven descent of gcd, from the core's center: the passes
+// gated at the restart overflow, so that each runs where a rise restarts the
+// momentum; RUDY reading the placements as congested, so that the phase
+// runs several passes and reverts to the snapshot after each; a reference
+// of 5,000 DBU, so that gcd's rises register (end_of_descent_test explains
+// it); and a target density of 0.9 with an inflation budget of 9 %, which
+// leave the inflated cells room to come back down to the gate. A descent
+// that stalls above the routability check overflow does not end: those
+// iterations do not count toward the iteration limit.
+TEST_F(RoutabilityMinimumTest, MomentumRestartStandsAsideOnAPassIteration)
+{
+  options_.routabilityCheckOverflow = kRestartOverflow;
+  options_.referenceHpwl = 5000;
+  options_.density = 0.9f;
+  options_.routabilityMaxInflationTotal = 0.09f;
+  makePlacer();
+  grt_.getRudy()->setWireWidth(2 * kWidth);
+  // Each iteration's measurement opens with PreviousHPWL and reads PhiCoef,
+  // the density penalty controller's reading of the HPWL change, and the
+  // overflow; a pass (GPL-0040) and a restart (GPL-0126) come later in the
+  // same iteration.
+  logger_.setDebugLevel(utl::GPL, "updateNextIter", 1);
+  logger_.redirectStringBegin();
+  const PlaceResult result = np_->doNesterovPlace();
+  const std::string log = logger_.redirectStringEnd();
+  logger_.setDebugLevel(utl::GPL, "updateNextIter", 0);
+  ASSERT_EQ(result.stop, PlaceStop::kConverged);
+
+  struct Iteration
+  {
+    float phi_coef = 1.0f;
+    float overflow = 1.0f;
+    bool pass = false;
+    bool restart = false;
+  };
+  std::vector<Iteration> iterations;
+  std::istringstream lines(log);
+  for (std::string line; std::getline(lines, line);) {
+    if (line.find("PreviousHPWL: ") != std::string::npos) {
+      iterations.emplace_back();
+    } else if (iterations.empty()) {
+      continue;
+    } else if (const size_t at = line.find("PhiCoef: ");
+               at != std::string::npos) {
+      iterations.back().phi_coef = std::stof(line.substr(at + 9));
+    } else if (const size_t at = line.find("] Overflow: ");
+               at != std::string::npos) {
+      iterations.back().overflow = std::stof(line.substr(at + 12));
+    } else if (line.find("GPL-0040]") != std::string::npos) {
+      iterations.back().pass = true;
+    } else if (line.find("GPL-0126]") != std::string::npos) {
+      iterations.back().restart = true;
+    }
+  }
+
+  int rising_passes = 0;
+  int restarts = 0;
+  for (size_t i = 0; i < iterations.size(); ++i) {
+    const Iteration& iteration = iterations[i];
+    rising_passes += iteration.pass && iteration.phi_coef < 1.0f
+                     && iteration.overflow <= kRestartOverflow;
+    restarts += iteration.restart;
+    EXPECT_FALSE(iteration.pass && iteration.restart)
+        << "iteration " << i << ": a routability pass ran on it, and the "
+        << "momentum must not be restarted there";
+  }
+  ASSERT_GT(rising_passes, 0)
+      << "a pass must run on an iteration whose HPWL rose at or below the "
+         "restart overflow, or the test says nothing about the pass";
+  EXPECT_GT(restarts, 0) << "the restart must be live in this descent";
+}
+
 }  // namespace gpl
