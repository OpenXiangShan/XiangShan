index 5fe0508..70fd6d6 100644
--- a/openroad/gpl/test/end_of_descent_test.cpp
+++ b/openroad/gpl/test/end_of_descent_test.cpp
@@ -4,7 +4,8 @@
 // How global placement's Nesterov descent ends.
 //
 // It ends on Nesterov's iterate, not on the look-ahead point one momentum
-// step past it.
+// step past it, and near its end it restarts its momentum on an iteration
+// whose wirelength rose.
 //
 // Each iteration takes a gradient step from the look-ahead v_k to the
 // iterate u_(k+1), then extrapolates the look-ahead
@@ -183,6 +184,75 @@ class EndOfDescentTest : public tst::Fixture
     return apart;
   }
 
+  // At or below it an HPWL rise restarts the momentum.
+  static constexpr float kRestartOverflow
+      = NesterovPlace::kRestartOnRiseOverflow;
+
+  // The iterations, as the trace numbers them, on which the momentum was
+  // restarted for an HPWL rise (GPL-0126 says "iter = " the next one).
+  static std::vector<int> restartIterations(const std::string& log)
+  {
+    static const std::string kRestart
+        = "GPL-0126] Restarting Nesterov momentum at iter = ";
+    std::vector<int> iterations;
+    for (size_t at = log.find(kRestart); at != std::string::npos;
+         at = log.find(kRestart, at + 1)) {
+      iterations.push_back(std::stoi(log.substr(at + kRestart.size())) - 1);
+    }
+    return iterations;
+  }
+
+  // The iterations of a trace that came down to the restart overflow and
+  // whose HPWL rose by more than the controller's reference: the controller
+  // lowered the density penalty (phiCoef below 1). The last row, on which
+  // the placement converged, has no next one to read the penalty from.
+  static std::vector<int> risesNearTheEnd(const PlaceResult& result)
+  {
+    std::vector<int> iterations;
+    for (size_t i = 0; i + 1 < result.trace.size(); ++i) {
+      if (result.trace[i].overflow <= kRestartOverflow
+          && result.trace[i + 1].density_penalty
+                 < result.trace[i].density_penalty) {
+        iterations.push_back(result.trace[i].iteration);
+      }
+    }
+    return iterations;
+  }
+
+  // The state an iteration's restart decision reads, as the loop leaves it
+  // after measuring a placement: nothing restarting the momentum, the
+  // region still descending.
+  static void startIteration(Placer& placer)
+  {
+    placer.np->reset_nesterov_momentum_ = false;
+    placer.nb().isConverged_ = false;
+  }
+
+  // A non-virtual timing-driven repair on this iteration has asked for the
+  // momentum restart.
+  static void setRepairRestarting(Placer& placer)
+  {
+    placer.np->reset_nesterov_momentum_ = true;
+  }
+
+  static void setConverged(Placer& placer) { placer.nb().isConverged_ = true; }
+
+  // Whether an iteration that measured `overflow`, with the density penalty
+  // controller at `phi_coef`, restarts the momentum.
+  static bool restartsAt(Placer& placer,
+                         const int iter,
+                         const float overflow,
+                         const float phi_coef,
+                         const bool after_routability_pass = false)
+  {
+    NesterovPlace& np = *placer.np;
+    np.average_overflow_unscaled_ = overflow;
+    placer.nb().phiCoef_ = phi_coef;
+    float cur_a = 2.0f;
+    np.restartMomentumOnRise(iter, after_routability_pass, cur_a);
+    return cur_a == 1.0f;
+  }
+
   PlaceOptions options_;
   PlaceResult twin_result_;
 };
@@ -247,4 +317,164 @@ TEST_F(EndOfDescentTest, TraceEndsOnTheIterate)
       << look_ahead_hpwl << ")";
 }
 
+// Near the end of a descent an iteration whose HPWL rose by more than the
+// density penalty controller's reference restarts the momentum, and only
+// such an iteration: the next one takes no momentum step. Late in a long
+// descent the momentum coefficient is about 0.997 and nothing else damps
+// the motion: on large designs the fillers, then the cells, run away and
+// the HPWL rises over the last iterations without it. The restart is not
+// once per descent: as the momentum builds up again and the HPWL rises
+// again, it restarts again.
+//
+// gcd's HPWL grows by at most about 12,000 DBU an iteration on the way
+// down (6,000 below overflow 0.2), far below the default reference
+// (446,000,000 DBU at least), so the reference is 5,000 DBU here. That also
+// eases the penalty earlier in the descent and makes it several times
+// longer; what is tested is where it restarts.
+TEST_F(EndOfDescentTest, MomentumRestartsWhereTheHpwlRises)
+{
+  options_.referenceHpwl = 5000;
+  const std::unique_ptr<Placer> run = makePlacer(options_);
+  ASSERT_NE(run, nullptr);
+  logger_.redirectStringBegin();
+  const PlaceResult result = run->np->doNesterovPlace();
+  const std::string log = logger_.redirectStringEnd();
+  ASSERT_EQ(result.stop, PlaceStop::kConverged);
+
+  const std::vector<int> rises = risesNearTheEnd(result);
+  ASSERT_GE(rises.size(), 2) << "the descent must rise near its end, twice";
+  const std::vector<int> restarts = restartIterations(log);
+  EXPECT_EQ(restarts, rises)
+      << "the momentum must restart on every rise near the end, and only "
+         "there";
+
+  bool restarted_again = false;
+  for (size_t i = 1; i < restarts.size(); ++i) {
+    restarted_again |= restarts[i] > restarts[i - 1] + 1;
+  }
+  EXPECT_TRUE(restarted_again)
+      << "a rise after the momentum has built up again must restart it again";
+
+  ASSERT_FALSE(restarts.empty());
+  const int restart = restarts.front();
+  ASSERT_LT(restart + 1, result.final_iteration);
+  const std::unique_ptr<Placer> before = runTwin(restart);
+  ASSERT_NE(before, nullptr);
+  ASSERT_GT(lookAheadsApart(*before), 0)
+      << "the descent must carry momentum up to the restart";
+  const std::unique_ptr<Placer> after = runTwin(restart + 1);
+  ASSERT_NE(after, nullptr);
+  EXPECT_EQ(lookAheadsApart(*after), 0)
+      << "the iteration after the restart must take no momentum step";
+}
+
+// A descent whose HPWL never rises that fast keeps its momentum to the end,
+// as it did before the restart existed: gcd with the default reference,
+// whose density penalty grows on every iteration down to the target.
+TEST_F(EndOfDescentTest, MomentumRunsOnWithoutARise)
+{
+  const std::unique_ptr<Placer> run = makePlacer(options_);
+  ASSERT_NE(run, nullptr);
+  logger_.redirectStringBegin();
+  const PlaceResult result = run->np->doNesterovPlace();
+  const std::string log = logger_.redirectStringEnd();
+  ASSERT_EQ(result.stop, PlaceStop::kConverged);
+
+  int near_the_end = -1;
+  for (const PlaceIteration& row : result.trace) {
+    if (row.overflow <= kRestartOverflow) {
+      near_the_end = row.iteration;
+      break;
+    }
+  }
+  ASSERT_GE(near_the_end, 0);
+  ASSERT_GT(result.final_iteration - near_the_end, 10)
+      << "the descent must spend a while below the restart overflow";
+  ASSERT_TRUE(risesNearTheEnd(result).empty())
+      << "this descent must not rise near its end";
+
+  EXPECT_TRUE(restartIterations(log).empty());
+  EXPECT_EQ(log.find("GPL-0126"), std::string::npos);
+
+  // The iteration after the descent came down to the restart overflow, and
+  // the last one, still take their momentum steps.
+  for (const int iteration : {near_the_end + 1, result.final_iteration}) {
+    const std::unique_ptr<Placer> twin = runTwin(iteration);
+    ASSERT_NE(twin, nullptr);
+    EXPECT_GT(lookAheadsApart(*twin), 0)
+        << "the momentum must not be restarted at iteration " << iteration;
+  }
+}
+
+// The restart decision, one iteration at a time: at or below the restart
+// overflow, on an HPWL rise (phiCoef below 1), and not when something else
+// owns the iteration. A non-virtual timing-driven repair on it restarts the
+// momentum itself, and its GPL-0111 is the only restart and the only log
+// line; a routability pass on it has reverted or inflated the placement
+// the rise was measured on (routability_minimum_test runs that in a
+// descent); and a region that has converged no longer moves.
+TEST_F(EndOfDescentTest, MomentumRestartsOnlyOnARiseNearTheEnd)
+{
+  const std::unique_ptr<Placer> placer = makePlacer(options_);
+  ASSERT_NE(placer, nullptr);
+
+  struct Case
+  {
+    float overflow;
+    float phi_coef;
+    const char* logged;  // nullptr: no restart
+  };
+  const std::vector<Case> cases = {
+      {0.5f, 0.95f, nullptr},
+      {0.21f, 0.95f, nullptr},
+      {0.2f, 0.95f, "overflow 0.2000, phiCoef 0.9500."},
+      {0.15f, 0.999f, "overflow 0.1500, phiCoef 0.9990."},
+      {0.1f, 1.0f, nullptr},
+      {0.1f, 1.04f, nullptr},
+      {0.05f, 0.97f, "overflow 0.0500, phiCoef 0.9700."},
+  };
+  int iter = 300;
+  for (const Case& c : cases) {
+    startIteration(*placer);
+    logger_.redirectStringBegin();
+    const bool restarted = restartsAt(*placer, iter, c.overflow, c.phi_coef);
+    const std::string log = logger_.redirectStringEnd();
+    EXPECT_EQ(restarted, c.logged != nullptr)
+        << "overflow " << c.overflow << ", phiCoef " << c.phi_coef;
+    if (c.logged != nullptr) {
+      EXPECT_NE(
+          log.find("GPL-0126] Restarting Nesterov momentum at iter = "
+                   + std::to_string(iter + 1) + ": HPWL rose at " + c.logged),
+          std::string::npos)
+          << log;
+    } else {
+      EXPECT_EQ(log.find("GPL-0126"), std::string::npos) << log;
+    }
+    ++iter;
+  }
+
+  startIteration(*placer);
+  setRepairRestarting(*placer);
+  logger_.redirectStringBegin();
+  EXPECT_FALSE(restartsAt(*placer, iter, 0.1f, 0.95f))
+      << "a non-virtual repair restarts the momentum on this iteration";
+  EXPECT_EQ(logger_.redirectStringEnd().find("GPL-0126"), std::string::npos);
+
+  startIteration(*placer);
+  EXPECT_FALSE(restartsAt(*placer,
+                          iter,
+                          0.1f,
+                          0.95f,
+                          /* after_routability_pass = */ true))
+      << "a routability pass has reverted or inflated the placement";
+
+  startIteration(*placer);
+  setConverged(*placer);
+  EXPECT_FALSE(restartsAt(*placer, iter, 0.1f, 0.95f))
+      << "a converged region no longer moves: its phiCoef does not count";
+
+  startIteration(*placer);
+  EXPECT_TRUE(restartsAt(*placer, iter, 0.1f, 0.95f));
+}
+
 }  // namespace gpl
