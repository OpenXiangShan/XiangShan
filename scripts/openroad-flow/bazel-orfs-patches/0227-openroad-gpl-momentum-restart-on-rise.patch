+                             float& curA);
   enum class DivergeAction
   {
     kNone,
@@ -280,6 +288,20 @@ class NesterovPlace
   // trajectory into the changed objective and diverge the placement.
   bool reset_nesterov_momentum_ = false;
 
+  // The overflow at or below which an HPWL rise restarts the momentum
+  // (restartMomentumOnRise()). Above it the cells are spreading, the HPWL
+  // rises because they spread, and the controller easing the penalty is the
+  // whole response. 0.2 is where checkDivergence() starts to read a rising
+  // HPWL as a divergence (GPL-0323). It is below the routability check
