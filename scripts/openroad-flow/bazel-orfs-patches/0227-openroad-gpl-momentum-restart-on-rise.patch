diff --git a/openroad/gpl/src/nesterovPlace.cpp b/openroad/gpl/src/nesterovPlace.cpp
index 3a1b7ab..29d9d2c 100644
--- a/openroad/gpl/src/nesterovPlace.cpp
+++ b/openroad/gpl/src/nesterovPlace.cpp
@@ -643,6 +643,51 @@ void NesterovPlace::runTimingDriven(int iter,
   }
 }
 
+void NesterovPlace::restartMomentumOnRise(const int iter,
+                                          const bool after_routability_pass,
+                                          float& curA)
+{
+  // Late in a long descent the momentum coefficient is about 0.997 and
+  // nothing damps the motion, while the density penalty under it changes
+  // every iteration. On a large design the fillers, which only the density
+  // moves, can speed up and take the cells with them: the HPWL rises over
+  // the last iterations of the placement. The density penalty controller
+  // reads each such iteration: phiCoef is below 1 when the HPWL rose by more
+  // than referenceHpwl since the last one, and the penalty is lowered. The
+  // momentum is restarted there, as after a non-virtual timing-driven
+  // repair, so that the next iteration takes no momentum step. A descent
+  // whose HPWL never rises that fast is left as it is; one that builds its
+  // momentum up again and rises again restarts again.
+  //
+  // A non-virtual repair on this iteration restarts the momentum itself
+  // (GPL-0111), and that is the only restart. A routability pass on this
+  // iteration may have reverted the placement whose HPWL was measured, or
+  // changed its cells' sizes; the next iteration measures its own. A region
+  // that has converged no longer moves, and its phiCoef may be an earlier
+  // iteration's: it does not count.
+  if (reset_nesterov_momentum_ || after_routability_pass
+      || average_overflow_unscaled_ > kRestartOnRiseOverflow) {
+    return;
+  }
+  float phi_coef = 1.0f;
+  for (const auto& nb : nbVec_) {
+    if (!nb->isConverged()) {
+      phi_coef = std::min(phi_coef, nb->getStoredPhiCoef());
+    }
+  }
+  if (phi_coef >= 1.0f) {
+    return;
+  }
+  curA = 1.0;
+  log_->info(GPL,
+             126,
+             "Restarting Nesterov momentum at iter = {}: HPWL rose at "
+             "overflow {:.4f}, phiCoef {:.4f}.",
+             iter + 1,
+             average_overflow_unscaled_,
+             phi_coef);
+}
+
 // Evaluate every gradient at curSLP on the repaired
 // netlist, in the same order as init().
 void NesterovPlace::refreshCurGradients()
@@ -1602,6 +1647,7 @@ PlaceResult NesterovPlace::doNesterovPlace(int start_iter)
                         routability_driven_revert_count,
                         timing_driven_count);
 
+    const int routability_passes = routability_driven_revert_count;
     runRoutability(nesterov_iter,
                    timing_driven_count,
                    routability_driven_dir,
@@ -1612,6 +1658,10 @@ PlaceResult NesterovPlace::doNesterovPlace(int start_iter)
       stop = PlaceStop::kConverged;
       break;
     }
+
+    restartMomentumOnRise(nesterov_iter,
+                          routability_driven_revert_count != routability_passes,
+                          curA);
   }
 
   // Unlike a divergence, running out of iterations says nothing about the
