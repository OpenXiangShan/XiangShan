+  float sinkInsertionDelay(odb::dbITerm* iterm);
+  // A macro tree one of whose sinks carries a cts_latency_offset.
+  bool hasLatencyOffsetSink(TreeBuilder* builder) const;
 
   void showGraph();
 
diff --git a/openroad/cts/src/TritonCTS.tcl b/openroad/cts/src/TritonCTS.tcl
index 1212b71..0580f7b 100644
--- a/openroad/cts/src/TritonCTS.tcl
+++ b/openroad/cts/src/TritonCTS.tcl
@@ -619,6 +619,29 @@ proc report_cts { args } {
 }
 
 namespace eval cts {
+# The latency balancer clocks the instance's clock pin offset later than
+# balanced (negative: earlier), offset in the user time unit, through the
+# instance's cts_latency_offset property (seconds). Call it before
+# clock_tree_synthesis; the property stays in the database.
+proc set_latency_offset { inst_name offset } {
+  set block [ord::get_db_block]
+  if { $block == "NULL" } {
+    utl::error CTS 140 "No design block found."
+  }
+  set inst [$block findInst $inst_name]
+  if { $inst == "NULL" } {
+    utl::error CTS 141 "set_latency_offset: no instance $inst_name."
+  }
+  sta::check_float "offset" $offset
+  set seconds [sta::time_ui_sta $offset]
+  set prop [odb::dbDoubleProperty_find $inst cts_latency_offset]
+  if { $prop == "NULL" } {
+    odb::dbDoubleProperty_create $inst cts_latency_offset $seconds
+  } else {
+    $prop setValue $seconds
+  }
+}
+
 proc clock_tree_synthesis_debug { args } {
   sta::parse_key_args "clock_tree_synthesis_debug" args \
     keys {} flags {-plot} ;# checker off
