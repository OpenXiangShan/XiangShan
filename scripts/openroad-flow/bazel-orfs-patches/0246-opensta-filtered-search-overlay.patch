+
+// The design's path the filter marks: the same tag less the filter's
+// states.
+bool
+ArrivalVisitor::designTwinExists(const Tag *filter_tag) const
+{
+  const ExceptionStateSet *states = filter_tag->states();
+  for (auto const [tag, path_index] : design_bldr_->pathIndexMap()) {
+    if (tag->scene() == filter_tag->scene()
+        && tag->rfIndex() == filter_tag->rfIndex()
+        && tag->minMaxIndex() == filter_tag->minMaxIndex()
+        && tag->clkInfo() == filter_tag->clkInfo()
+        && tag->isClock() == filter_tag->isClock()
+        && tag->isSegmentStart() == filter_tag->isSegmentStart()
+        && tag->inputDelay() == filter_tag->inputDelay()) {
+      const ExceptionStateSet *tag_states = tag->states();
+      size_t design_count = 0;
+      bool match = true;
+      if (states) {
+        for (ExceptionState *state : *states) {
+          if (!state->exception()->isFilter()) {
+            design_count++;
+            if (tag_states == nullptr || !tag_states->contains(state)) {
+              match = false;
+              break;
+            }
+          }
+        }
+      }
+      if (match && design_count == (tag_states ? tag_states->size() : 0))
+        return true;
+    }
+  }
+  return false;
+}
+
+// Propagate the filter's paths from the fanins over the vertex's own
+// arrivals, which stay as they are.
+void
+ArrivalVisitor::visitFilterOverlay(Vertex *vertex,
+                                   bool with_latch_edges)
+{
+  debugPrint(debug_, "search", 2, "find filter arrivals {}",
+             vertex->to_string(this));
+  tag_bldr_->init(vertex);
+  has_fanin_one_ = graph_->hasFaninOne(vertex);
+  if (crpr_active_ && !has_fanin_one_)
+    tag_bldr_no_crpr_->init(vertex);
+
+  from_filter_only_ = true;
+  visitFaninPaths(vertex, with_latch_edges);
+  from_filter_only_ = false;
+  if (crpr_active_
+      && search_->crprPathPruningEnabled()
+      && tag_bldr_->hasPropagatedClk() && !has_fanin_one_)
+    pruneCrprArrivals();
+
+  // A fanin that is a filter start offers the design's paths too;
+  // only what the filter marks is kept.
+  filter_bldr_->init(vertex);
+  for (auto const [tag, path_index] : tag_bldr_->pathIndexMap()) {
+    if (isFilterTag(tag))
+      filter_bldr_->insertPath(*tag_bldr_->path(path_index));
+  }
+  bool changed = search_->filterArrivalsChanged(vertex, filter_bldr_);
+  if (changed && network_->isLatchData(vertex->pin()))
+    search_->postponeLatchDataOutputs(vertex);
+  if (changed) {
+    search_->setVertexFilterArrivals(vertex, filter_bldr_, tag_group_cache_,
+                                     filtered_arrivals_);
+    enqueueFanouts(vertex, false);
+  }
+}
+
+// A filter start's paths are the design's own, marked by the filter:
+// the arrivals are found as in a full visit and the marked ones kept
+// beside the design's paths, which stay as they are.
+void
+ArrivalVisitor::visitFilterStart(Vertex *vertex,
+                                 bool with_latch_edges)
+{
+  debugPrint(debug_, "search", 2, "find filter start arrivals {}",
+             vertex->to_string(this));
+  tag_bldr_->init(vertex);
+  has_fanin_one_ = graph_->hasFaninOne(vertex);
+  if (crpr_active_ && !has_fanin_one_)
+    tag_bldr_no_crpr_->init(vertex);
+
+  visitFaninPaths(vertex, with_latch_edges);
+  if (crpr_active_
+      && search_->crprPathPruningEnabled()
+      && tag_bldr_->hasPropagatedClk() && !has_fanin_one_)
+    pruneCrprArrivals();
+  seedArrivals(vertex);
+
+  filter_bldr_->init(vertex);
+  for (auto const [tag, path_index] : tag_bldr_->pathIndexMap()) {
+    if (isFilterTag(tag))
+      filter_bldr_->insertPath(*tag_bldr_->path(path_index));
+  }
+  bool changed = search_->filterArrivalsChanged(vertex, filter_bldr_);
+  if (changed && network_->isLatchData(vertex->pin()))
+    search_->postponeLatchDataOutputs(vertex);
+  if (changed)
+    search_->setVertexFilterArrivals(vertex, filter_bldr_, tag_group_cache_,
+                                     filtered_arrivals_);
+  // The filter's state is also minted on the edges out of the start,
+  // from the design's paths, so the fanouts look at all of them.
+  enqueueFanouts(vertex, false);
+}
+
+void
+ArrivalVisitor::enqueueFanouts(Vertex *vertex,
+                               bool full_visit)
+{
+  graph_->visitFanoutEdges(vertex, search_adj_,
+                           [this, vertex, full_visit] (Edge *edge,
+                                                       Vertex *fanout) {
+                             if (edge->isDisabledLoop()) {
+                               if (hasPendingLoopPaths(edge))
+                                 search_->postponeArrivals(fanout);
+                             }
+                             else if (clks_only_ && vertex->isRegClk())
+                               search_->arrivalInvalid(fanout);
+                             else {
+                               if (full_visit)
+                                 search_->requireFullVisit(fanout);
+                               search_->arrivalIterator()->enqueue(fanout);
+                             }
+                           });
 }
 
