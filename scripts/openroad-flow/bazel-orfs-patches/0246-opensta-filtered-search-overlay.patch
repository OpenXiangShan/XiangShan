+
+void
+Search::deleteFilterPaths(Vertex *vertex)
+{
+  TagGroup *tag_group = filterTagGroup(vertex);
+  if (tag_group) {
+    vertex->deleteFilterPaths();
+    tag_group->decrRefCount();
+  }
+}
+
+TagGroup *
+Search::filterTagGroup(const Vertex *vertex) const
+{
+  TagGroupIndex index = vertex->filterTagGroupIndex();
+  if (index == tag_group_index_max)
+    return nullptr;
+  else
+    return tag_groups_[index];
+}
+
+bool
+Search::fullVisitRequired(const Vertex *vertex) const
+{
+  VertexId id = graph_->id(vertex);
+  return id < visit_gen_size_
+    && full_visit_gen_[id].load(std::memory_order_relaxed) == filter_gen_;
+}
+
+void
+Search::requireFullVisit(Vertex *vertex)
+{
+  VertexId id = graph_->id(vertex);
+  if (id < visit_gen_size_)
+    full_visit_gen_[id].store(filter_gen_, std::memory_order_relaxed);
+}
+
+bool
+Search::isFilterStart(const Vertex *vertex) const
+{
+  VertexId id = graph_->id(vertex);
+  return id < visit_gen_size_
+    && filter_start_gen_[id].load(std::memory_order_relaxed) == filter_gen_;
+}
+
+void
+Search::seedFilterStart(Vertex *vertex)
+{
+  VertexId id = graph_->id(vertex);
+  if (filter_overlay_ && id < visit_gen_size_)
+    filter_start_gen_[id].store(filter_gen_, std::memory_order_relaxed);
+  arrival_iter_->enqueue(vertex);
+}
+
+void
+Search::noteFullVisit(Vertex *vertex)
+{
+  LockGuard lock(filter_full_visited_lock_);
+  filter_full_visited_.insert(vertex);
 }
 
