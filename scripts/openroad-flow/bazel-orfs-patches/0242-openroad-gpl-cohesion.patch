@@ -0,0 +1,477 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// global_placement -clusters_file: each named group of cells is pulled
+// toward its own centroid, or toward an anchor, during Nesterov placement.
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <fstream>
+#include <functional>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "gpl/Replace.h"
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "odb/dbTypes.h"
+#include "odb/defin.h"
+#include "odb/geom.h"
+#include "odb/lefin.h"
+#include "openroad/gpl/src/graphicsNone.h"
+#include "openroad/gpl/src/nesterovBase.h"
+#include "openroad/gpl/src/nesterovPlace.h"
+#include "openroad/gpl/src/placerBase.h"
+#include "openroad/gpl/src/point.h"
+#include "tst/fixture.h"
+#include "utl/deleter.h"
+
+namespace gpl {
+
+class CohesionTest : public tst::Fixture
+{
+ protected:
+  // gcd (294 cells) with every movable cell starting at the core's center.
+  struct Placer
+  {
+    // Declared first, so that it outlives the placer that points into it.
+    utl::UniquePtrWithDeleter<odb::dbDatabase> db;
+    std::shared_ptr<PlacerBaseCommon> pbc;
+    std::shared_ptr<NesterovBaseCommon> nbc;
+    std::vector<std::shared_ptr<PlacerBase>> pb_vec;
+    std::vector<std::shared_ptr<NesterovBase>> nb_vec;
+    std::unique_ptr<NesterovPlace> np;
+
+    NesterovBase& nb() const { return *nb_vec.front(); }
+    odb::dbBlock* block() const { return db->getChip()->getBlock(); }
+  };
+
+  // The database, with `before` run on its block before the placer is made.
+  std::unique_ptr<Placer> makePlacer(
+      const PlaceOptions& options,
+      const std::function<void(odb::dbBlock*)>& before = nullptr)
+  {
+    auto placer = std::make_unique<Placer>();
+    placer->db = utl::UniquePtrWithDeleter<odb::dbDatabase>(
+        odb::dbDatabase::create(), odb::dbDatabase::destroy);
+    placer->db->setLogger(&logger_);
+    const std::string dir = "_main/openroad/gpl/test/";
+    odb::lefin lef_reader(
+        placer->db.get(), &logger_, /* ignore_non_routing_layers = */ false);
+    odb::dbLib* lib = lef_reader.createTechAndLib(
+        "tech", "lib", getFilePath(dir + "nangate45.lef").c_str());
+    if (lib == nullptr) {
+      ADD_FAILURE() << "nangate45.lef did not load";
+      return nullptr;
+    }
+    odb::dbChip* chip = odb::dbChip::create(placer->db.get(), lib->getTech());
+    std::vector<odb::dbLib*> libs{lib};
+    odb::defin def_reader(placer->db.get(), &logger_);
+    if (!def_reader.readChip(
+            libs, getFilePath(dir + "gcd.def").c_str(), chip)) {
+      ADD_FAILURE() << "gcd.def did not load";
+      return nullptr;
+    }
+    odb::dbBlock* block = chip->getBlock();
+    const odb::Point center = block->getCoreArea().center();
+    for (odb::dbInst* inst : block->getInsts()) {
+      if (!inst->isFixed()) {
+        inst->setLocation(center.x(), center.y());
+        inst->setPlacementStatus(odb::dbPlacementStatus::PLACED);
+      }
+    }
+    if (before) {
+      before(block);
+    }
+
+    const PlacerBaseVars pb_vars(options);
+    placer->pbc = std::make_shared<PlacerBaseCommon>(
+        placer->db.get(), pb_vars, &logger_);
+    placer->pb_vec.push_back(std::make_shared<PlacerBase>(
+        placer->db.get(), placer->pbc, &logger_, /* check_density = */ false));
+    const NesterovBaseVars nb_vars(options);
+    placer->nbc = std::make_shared<NesterovBaseCommon>(
+        nb_vars, placer->pbc, &logger_, /* num_threads = */ 1, Clusters{});
+    // As the RouteBase that a placement without one does not have: the
+    // callbacks that create and destroy gcells keep it in step.
+    placer->nbc->resizeMinRcCellSize();
+    placer->nb_vec.push_back(std::make_shared<NesterovBase>(
+        nb_vars, placer->pb_vec[0], placer->nbc, &logger_));
+    const NesterovPlaceVars np_vars(options, placer->nbc->getHpwl());
+    placer->np
+        = std::make_unique<NesterovPlace>(np_vars,
+                                          placer->pbc,
+                                          placer->nbc,
+                                          placer->pb_vec,
+                                          placer->nb_vec,
+                                          /* rb = */ nullptr,
+                                          /* tb = */ nullptr,
+                                          /* cb = */ nullptr,
+                                          /* pwb = */ nullptr,
+                                          std::make_unique<GraphicsNone>(),
+                                          &logger_);
+    return placer;
+  }
+
+  // The group: every 10th movable instance of gcd, which the placement
+  // spreads over the core.
+  static std::vector<std::string> groupNames(odb::dbBlock* block)
+  {
+    std::vector<std::string> names;
+    int i = 0;
+    for (odb::dbInst* inst : block->getInsts()) {
+      if (!inst->isFixed() && (i++ % 10) == 0) {
+        names.push_back(inst->getName());
+      }
+    }
+    return names;
+  }
+
+  std::string writeFile(const std::string& name, const std::string& text)
+  {
+    const std::string path = ::testing::TempDir() + name;
+    std::ofstream out(path);
+    out << text;
+    return path;
+  }
+
+  static std::string quoted(const std::vector<std::string>& names)
+  {
+    std::string list;
+    for (const std::string& name : names) {
+      list += (list.empty() ? "\"" : ", \"") + name + "\"";
+    }
+    return list;
+  }
+
+  // A clusters file with one group of `names`.
+  std::string clustersFile(const std::vector<std::string>& names,
+                           const double weight = 1,
+                           const std::string& extra = "",
+                           const double tau_iter = 0)
+  {
+    return writeFile("clusters.json",
+                     "{\"tau_iter\": " + std::to_string(tau_iter)
+                         + ", \"clusters\": [{\"name\": \"group\", "
+                           "\"prefixes\": ["
+                         + quoted(names) + "], " + extra + "\"weight\": "
+                         + std::to_string(weight) + "}]}");
+  }
+
+  struct Spread
+  {
+    double cx = 0;  // the group's centroid, DBU
+    double cy = 0;
+    double rms = 0;  // RMS distance of its cells from the centroid, DBU
+  };
+
+  // Where the placement left the group's cells.
+  static Spread spread(const Placer& placer,
+                       const std::vector<std::string>& names)
+  {
+    std::vector<odb::Point> at;
+    for (const std::string& name : names) {
+      odb::dbInst* inst = placer.block()->findInst(name.c_str());
+      at.push_back(inst->getBBox()->getBox().center());
+    }
+    Spread s;
+    for (const odb::Point& p : at) {
+      s.cx += p.x();
+      s.cy += p.y();
+    }
+    s.cx /= at.size();
+    s.cy /= at.size();
+    for (const odb::Point& p : at) {
+      s.rms
+          += (p.x() - s.cx) * (p.x() - s.cx) + (p.y() - s.cy) * (p.y() - s.cy);
+    }
+    s.rms = std::sqrt(s.rms / at.size());
+    return s;
+  }
+
+  // Places gcd with `options` and says where the group ended up.
+  Spread place(const PlaceOptions& options,
+               const std::vector<std::string>& names)
+  {
+    const std::unique_ptr<Placer> placer = makePlacer(options);
+    if (placer == nullptr) {
+      return {};
+    }
+    const PlaceResult result = placer->np->doNesterovPlace();
+    EXPECT_EQ(result.stop, PlaceStop::kConverged);
+    EXPECT_LE(result.overflow, options.overflow);
+    return spread(*placer, names);
+  }
+
+  // The names of the group's cells.
+  std::vector<std::string> names_;
+  PlaceOptions options_;
+
+  void SetUp() override
+  {
+    const std::unique_ptr<Placer> placer = makePlacer(options_);
+    ASSERT_NE(placer, nullptr);
+    names_ = groupNames(placer->block());
+    ASSERT_GE(names_.size(), 25u);
+  }
+
+  static const std::vector<int>& groups(const Placer& placer)
+  {
+    return placer.nb().cohesion_group_;
+  }
+
+  static const std::vector<FloatPoint>& forces(const Placer& placer)
+  {
+    return placer.nb().cohesion_force_;
+  }
+
+  // The group each of nb_gcells_ should be in: instances by name, -1 for
+  // fillers and the rest.
+  static std::vector<int> expectedGroups(
+      const Placer& placer,
+      const std::function<int(const std::string&)>& group_of)
+  {
+    std::vector<int> expected;
+    for (const GCellHandle& cell : placer.nb().getGCells()) {
+      expected.push_back(cell->isInstance()
+                             ? group_of(cell->insts()[0]->dbInst()->getName())
+                             : -1);
+    }
+    return expected;
+  }
+
+  // Where the instance `name` is in nb_gcells_.
+  static size_t indexOf(const Placer& placer, const std::string& name)
+  {
+    const std::vector<GCellHandle>& cells = placer.nb().getGCells();
+    for (size_t i = 0; i < cells.size(); ++i) {
+      if (cells[i]->isInstance()
+          && cells[i]->insts()[0]->dbInst()->getName() == name) {
+        return i;
+      }
+    }
+    ADD_FAILURE() << name << " is not in nb_gcells_";
+    return cells.size();
+  }
+
+  // A pin-less buffer a quarter of the way in from the core's lower left
+  // corner, away from the cells, made as the callbacks of a timing-driven
+  // repair make one: appended to nb_gcells_.
+  static odb::dbInst* insertBuffer(Placer& placer, const char* name)
+  {
+    odb::dbBlock* block = placer.block();
+    odb::dbMaster* master = placer.db->findMaster("BUF_X1");
+    odb::dbInst* inst = odb::dbInst::create(block, master, name);
+    const odb::Rect core = block->getCoreArea();
+    inst->setLocation(core.xMin() + core.dx() / 4, core.yMin() + core.dy() / 4);
+    inst->setPlacementStatus(odb::dbPlacementStatus::PLACED);
+    const size_t index = placer.nbc->createCbkGCell(inst);
+    placer.nb().createCbkGCell(inst, index);
+    placer.nbc->fixPointers();
+    return inst;
+  }
+
+  // Removes it as the callbacks of a repair do: the last of nb_gcells_
+  // takes its place.
+  static void destroyBuffer(Placer& placer, odb::dbInst* inst)
+  {
+    const auto replacement = placer.nb().destroyCbkGCell(inst);
+    ASSERT_TRUE(replacement.has_value());
+    if (replacement->first != nullptr) {
+      ASSERT_TRUE(
+          placer.nb().updateHandle(replacement->first, replacement->second));
+    }
+    odb::dbInst::destroy(inst);
+    placer.nbc->fixPointers();
+  }
+};
+
+// The group's cells end up closer together than the placement leaves them
+// without the pull, the more so the heavier the weight, and the placement
+// still converges.
+TEST_F(CohesionTest, ClusterPullsItsCellsTogether)
+{
+  const Spread without = place(options_, names_);
+
+  PlaceOptions options = options_;
+  options.clustersFile = clustersFile(names_, /* weight = */ 1);
+  logger_.redirectStringBegin();
+  const Spread with = place(options, names_);
+  const std::string log = logger_.redirectStringEnd();
+  options.clustersFile = clustersFile(names_, /* weight = */ 4);
+  const Spread heavier = place(options, names_);
+
+  EXPECT_NE(log.find("GPL-0341] Cluster group weight 1: "
+                     + std::to_string(names_.size()) + " cells."),
+            std::string::npos)
+      << log;
+  // gcd: 22,507 DBU without, 19,364 at weight 1, 6,058 at weight 4.
+  EXPECT_LT(with.rms, 0.95 * without.rms)
+      << "RMS radius at weight 1 " << with.rms << " DBU, without "
+      << without.rms;
+  EXPECT_LT(heavier.rms, 0.5 * with.rms)
+      << "RMS radius at weight 4 " << heavier.rms << " DBU, at weight 1 "
+      << with.rms;
+}
+
+// An anchor pulls the group to it: its centroid ends up nearer the anchor
+// than the placement leaves it without the pull.
+TEST_F(CohesionTest, AnchorPullsTheClusterToIt)
+{
+  const std::unique_ptr<Placer> probe = makePlacer(options_);
+  ASSERT_NE(probe, nullptr);
+  const odb::Rect core = probe->block()->getCoreArea();
+  const double dbu = probe->block()->getDbUnitsPerMicron();
+  // A quarter of the way in from the core's lower left corner.
+  const double ax = core.xMin() + 0.25 * core.dx();
+  const double ay = core.yMin() + 0.25 * core.dy();
+
+  const Spread without = place(options_, names_);
+  PlaceOptions options = options_;
+  options.clustersFile
+      = clustersFile(names_,
+                     /* weight = */ 4,
+                     "\"anchor_um\": [" + std::to_string(ax / dbu) + ", "
+                         + std::to_string(ay / dbu) + "], ");
+  logger_.redirectStringBegin();
+  const Spread with = place(options, names_);
+  const std::string log = logger_.redirectStringEnd();
+
+  EXPECT_NE(log.find("GPL-0341] Cluster group weight 4 anchored: "),
+            std::string::npos)
+      << log;
+  const double before = std::hypot(without.cx - ax, without.cy - ay);
+  const double after = std::hypot(with.cx - ax, with.cy - ay);
+  EXPECT_LT(after, 0.5 * before) << "centroid to anchor with the pull " << after
+                                 << " DBU, without " << before;
+}
+
+// With tau_iter > 0 the pull fades: a short tau shapes the start and lets
+// the group go, and it ends up as spread as without the pull.
+TEST_F(CohesionTest, ShortTauLetsTheClusterGo)
+{
+  const Spread without = place(options_, names_);
+  PlaceOptions held = options_;
+  held.clustersFile = clustersFile(names_, /* weight = */ 4);
+  const Spread held_spread = place(held, names_);
+
+  PlaceOptions fading = options_;
+  fading.clustersFile
+      = clustersFile(names_, /* weight = */ 4, "", /* tau_iter = */ 20);
+  const Spread fading_spread = place(fading, names_);
+
+  EXPECT_GT(fading_spread.rms, 3 * held_spread.rms)
+      << "RMS radius with tau_iter 20 " << fading_spread.rms
+      << " DBU, held to the end " << held_spread.rms;
+  EXPECT_NEAR(fading_spread.rms, without.rms, 0.05 * without.rms);
+}
+
+// The groups follow the cells when nb_gcells_ changes under them, as a
+// timing-driven repair or routability's fillers change it: a cell that
+// takes another's index takes its own group, not the other's.
+TEST_F(CohesionTest, GroupsFollowTheCellsWhenTheListChanges)
+{
+  std::vector<std::string> prefixes = names_;
+  prefixes.emplace_back("keep");  // a module: keep/... and not keepx
+  PlaceOptions options = options_;
+  options.clustersFile = clustersFile(prefixes);
+  std::unique_ptr<Placer> placer = makePlacer(options);
+  ASSERT_NE(placer, nullptr);
+  const auto group_of = [&](const std::string& name) {
+    if (name.rfind("keep/", 0) == 0
+        || std::ranges::find(names_, name) != names_.end()) {
+      return 0;
+    }
+    return -1;
+  };
+  const float coef = 1;  // the gradients are not looked at
+
+  // A member, appended after the fillers, in the groups made at the next
+  // gradient.
+  odb::dbInst* transient = insertBuffer(*placer, "keep/transient");
+  placer->nb().nbUpdateCurGradient(coef, coef);
+  ASSERT_EQ(groups(*placer), expectedGroups(*placer, group_of));
+
+  // A cell that is not a member is appended and the member removed: the
+  // newcomer takes the member's index and the list has its old length.
+  const size_t length = placer->nb().getGCells().size();
+  const size_t index = indexOf(*placer, "keep/transient");
+  insertBuffer(*placer, "keepx");
+  destroyBuffer(*placer, transient);
+  ASSERT_EQ(placer->nb().getGCells().size(), length);
+  ASSERT_EQ(indexOf(*placer, "keepx"), index);
+
+  placer->nb().nbUpdateCurGradient(coef, coef);
+  EXPECT_EQ(groups(*placer), expectedGroups(*placer, group_of));
+  EXPECT_EQ(groups(*placer)[index], -1);
+  ASSERT_EQ(forces(*placer).size(), length);
+  EXPECT_EQ(forces(*placer)[index].x, 0) << "keepx is pulled";
+  EXPECT_EQ(forces(*placer)[index].y, 0) << "keepx is pulled";
+
+  // A member appended later is pulled with the rest.
+  insertBuffer(*placer, "keep/late");
+  placer->nb().nbUpdateCurGradient(coef, coef);
+  EXPECT_EQ(groups(*placer), expectedGroups(*placer, group_of));
+  const size_t late = indexOf(*placer, "keep/late");
+  EXPECT_EQ(groups(*placer)[late], 0);
+  EXPECT_GT(forces(*placer)[late].x, 0) << "toward the group, up and right";
+  EXPECT_GT(forces(*placer)[late].y, 0) << "toward the group, up and right";
+}
+
+// A file that cannot be read, is not a clusters file, or names a group
+// that matches no cell stops the placement.
+TEST_F(CohesionTest, BadFilesAreHardStops)
+{
+  const auto error_of = [&](const std::string& path) {
+    PlaceOptions options = options_;
+    options.clustersFile = path;
+    logger_.redirectStringBegin();
+    std::string what;
+    try {
+      makePlacer(options);
+    } catch (const std::runtime_error& e) {
+      what = e.what();
+    }
+    logger_.redirectStringEnd();
+    return what;
+  };
+  const std::string group
+      = "\"name\": \"g\", \"prefixes\": [\"" + names_.front() + "\"], ";
+
+  EXPECT_EQ(error_of(::testing::TempDir() + "no_such_file.json"), "GPL-0343");
+  EXPECT_EQ(error_of(writeFile("not_json.json", "{\"clusters\": [")),
+            "GPL-0344");
+  EXPECT_EQ(error_of(writeFile("no_clusters.json", "{\"tau_iter\": 0}")),
+            "GPL-0344");
+  EXPECT_EQ(
+      error_of(writeFile(
+          "no_weight.json",
+          "{\"clusters\": [{" + group.substr(0, group.size() - 2) + "}]}")),
+      "GPL-0344");
+  EXPECT_EQ(error_of(writeFile(
+                "weight_string.json",
+                "{\"clusters\": [{" + group + "\"weight\": \"one\"}]}")),
+            "GPL-0344");
+  EXPECT_EQ(
+      error_of(writeFile("negative.json",
+                         "{\"clusters\": [{" + group + "\"weight\": -1}]}")),
+      "GPL-0344");
+  EXPECT_EQ(error_of(writeFile("anchor3.json",
+                               "{\"clusters\": [{" + group
+                                   + "\"anchor_um\": [1, 2, 3], "
+                                     "\"weight\": 1}]}")),
+            "GPL-0344");
+  EXPECT_EQ(error_of(writeFile("nothing.json",
+                               "{\"clusters\": [{\"name\": \"g\", "
+                               "\"prefixes\": [\"no_such_cell\"], "
+                               "\"weight\": 1}]}")),
+            "GPL-0342");
+  EXPECT_EQ(error_of(writeFile(
+                "ok.json", "{\"clusters\": [{" + group + "\"weight\": 1}]}")),
+            "");
+}
+
