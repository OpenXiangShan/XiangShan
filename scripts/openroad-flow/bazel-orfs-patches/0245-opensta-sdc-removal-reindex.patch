 include/sta/Sdc.hh                  |  1 +
 sdc/Sdc.cc                          | 58 +++++++++++++++++-----
 test/CMakeLists.txt                 |  1 +
 test/sdc_delete_exception_insts.tcl | 75 +++++++++++++++++++++++++++++
 test/sdc_delete_exception_insts.v   | 20 ++++++++
 6 files changed, 147 insertions(+), 12 deletions(-)
 create mode 100644 test/sdc_delete_exception_insts.tcl
 create mode 100644 test/sdc_delete_exception_insts.v

