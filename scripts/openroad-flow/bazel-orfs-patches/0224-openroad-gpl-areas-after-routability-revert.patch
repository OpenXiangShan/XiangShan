 openroad/gpl/test/BUILD                       |  19 ++
 .../gpl/test/routability_minimum_test.cpp     | 269 ++++++++++++++++++
 6 files changed, 299 insertions(+)
 create mode 100644 openroad/gpl/test/routability_minimum_test.cpp

