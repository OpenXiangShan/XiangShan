+++ b/openroad/gpl/src/nesterovBase.h
@@ -1384,6 +1384,7 @@ class NesterovBase
 
  private:
   friend class TimingRepairIntegrationTest;
+  friend class RoutabilityMinimumTest;
 
   NesterovBaseVars nbVars_;
   std::shared_ptr<PlacerBase> pb_;
diff --git a/openroad/gpl/src/nesterovPlace.h b/openroad/gpl/src/nesterovPlace.h
index 6437ab9..676883e 100644
--- a/openroad/gpl/src/nesterovPlace.h
+++ b/openroad/gpl/src/nesterovPlace.h
@@ -108,6 +108,7 @@ class NesterovPlace
 
  private:
   friend class TimingRepairIntegrationTest;
+  friend class RoutabilityMinimumTest;
 
   void updateIterGraphics(int iter,
                           const std::string& reports_dir,
diff --git a/openroad/gpl/src/routeBase.cpp b/openroad/gpl/src/routeBase.cpp
index 7d6ed1e..e1db0e1 100644
--- a/openroad/gpl/src/routeBase.cpp
+++ b/openroad/gpl/src/routeBase.cpp
@@ -305,6 +305,14 @@ void RouteBase::revertToMinCongestion()
 
     nbVec_[j]->setTargetDensity(minRcTargetDensity_[j]);
     nbVec_[j]->restoreRemovedFillers();
+    // The cells are back at the minimum's sizes, and the overflow is a
+    // fraction of their area: without this it would be measured against the
+    // sizes the cells just left. The same bookkeeping routability() does
+    // after inflating.
+    nbVec_[j]->updateAreas();
+    nbVec_[j]->setMovableArea(static_cast<int64_t>(
+        nbVec_[j]->getWhiteSpaceArea() * nbVec_[j]->getTargetDensity()));
+    nbVec_[j]->checkConsistency();
     nbVec_[j]->updateDensitySize();
     accumulatedInflatedAreaDelta_[j] = minRcInflatedAreaDelta_[j];
   }
diff --git a/openroad/gpl/src/routeBase.h b/openroad/gpl/src/routeBase.h
index 2a894e5..5b77c46 100644
--- a/openroad/gpl/src/routeBase.h
+++ b/openroad/gpl/src/routeBase.h
@@ -214,6 +214,7 @@ class RouteBase
 
  private:
   friend class TimingRepairIntegrationTest;
+  friend class RoutabilityMinimumTest;
 
   RouteBaseVars rbVars_;
   odb::dbDatabase* db_ = nullptr;
