diff --git a/openroad/gpl/test/routability_first_pass_minimum.tcl b/openroad/gpl/test/routability_first_pass_minimum.tcl
new file mode 100644
index 0000000..5fbf532
--- /dev/null
+++ b/openroad/gpl/test/routability_first_pass_minimum.tcl
@@ -0,0 +1,45 @@
+# A routability phase whose minimum is its first pass ends on the placement
+# that pass measured, with the Nesterov state the loop had there: no inflation
+# helped, so the placement is the one a run without the phase ends on. That
+# holds whether pass 1 ran at the target overflow, where the loop converges on
+# it, or above it, where the descent goes on from it. medium01's congestion
+# stays above a target of 0.5 and no pass improves on the first by enough
+# (GPL-0054).
+source helpers.tcl
+read_lef ./nangate45.lef
+read_def ./medium01.def
+
+set block [ord::get_db_block]
+set initial {}
+foreach inst [$block getInsts] {
+  lappend initial $inst [$inst getLocation] [$inst getPlacementStatus]
+}
+
+# Places medium01 from the def's placement; returns every instance's location.
+proc place { log_var args } {
+  upvar 1 $log_var log
+  foreach {inst location status} $::initial {
+    $inst setLocation {*}$location
+    $inst setPlacementStatus $status
+  }
+  tee -quiet -variable log "global_placement -density 0.8 $args"
+  set locations {}
+  foreach inst [$::block getInsts] {
+    lappend locations [$inst getName] {*}[$inst getLocation]
+  }
+  return $locations
+}
+
+set without_phase [place log]
+foreach overflow {0.10 0.30} {
+  set placement [place log -routability_driven \
+    -routability_target_rc_metric 0.5 \
+    -routability_check_overflow $overflow]
+  if { $placement ne $without_phase } {
+    error "at overflow $overflow the placement is not the one without the phase"
+  }
+  if { [string first GPL-0125 $log] < 0 } {
+    error "at overflow $overflow the phase did not end on pass 1 (GPL-0125)"
+  }
+}
+puts pass
