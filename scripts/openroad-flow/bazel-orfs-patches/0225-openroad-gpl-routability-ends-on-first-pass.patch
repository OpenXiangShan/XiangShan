+void NesterovBase::saveFirstPassSnapshot()
+{
+  if (isConverged_) {
+    return;
+  }
+  pullSlpFromDevice();
+
+  first_pass_snapshot_.saved = true;
+  first_pass_snapshot_.coordi = curCoordi_;
+  first_pass_snapshot_.slp_coordi = curSLPCoordi_;
+  first_pass_snapshot_.slp_sum_grads = curSLPSumGrads_;
+  first_pass_snapshot_.prev_slp_sum_grads = prevSLPSumGrads_;
+  first_pass_snapshot_.density_penalty = densityPenalty_;
+  first_pass_snapshot_.step_length = stepLength_;
+  first_pass_snapshot_.sum_overflow = sum_overflow_;
+  first_pass_snapshot_.sum_overflow_unscaled = sum_overflow_unscaled_;
+  first_pass_snapshot_.prev_hpwl = prev_hpwl_;
+  if (io_) {
+    io_->saveFirstPassSnapshot();
+  }
+}
+
+void NesterovBase::revertToFirstPassSnapshot()
+{
+  if (isConverged_ || !first_pass_snapshot_.saved) {
+    return;
+  }
+  pullCoordsFromDevice();
+  curCoordi_ = first_pass_snapshot_.coordi;
+  curSLPCoordi_ = first_pass_snapshot_.slp_coordi;
+  curSLPSumGrads_ = first_pass_snapshot_.slp_sum_grads;
+  prevSLPSumGrads_ = first_pass_snapshot_.prev_slp_sum_grads;
+  densityPenalty_ = first_pass_snapshot_.density_penalty;
+  stepLength_ = first_pass_snapshot_.step_length;
+  if (io_) {
+    io_->revertToFirstPassSnapshot();
+  }
+
+  // The loop measures a placement on its look-ahead coordinates:
+  // nesterovUpdateCoordinates() puts the density there, and the overflow, the
+  // HPWL and RUDY restored with this snapshot were read on them.
+  updateGCellDensityCenterLocation(curSLPCoordi_);
+  updateDensityFieldBin();
+
+#ifdef ENABLE_GPU
+  if (nb_device_ctx_) {
+    nb_device_ctx_->syncCoordsToDevice(curSLPCoordi_,
+                                       prevSLPCoordi_,
+                                       curCoordi_,
+                                       curSLPSumGrads_,
+                                       prevSLPSumGrads_);
+    commitCoordsToDeviceState(SlpSlot::Cur);
+    host_coords_fresh_ = true;
+  }
+#endif
+
+  isDiverged_ = false;
+  prev_reported_hpwl_ = 0;
+  prev_reported_overflow_unscaled_ = 0;
+
+  // Unlike the routability snapshot, this one holds what was measured on its
+  // placement, so the overflow describes the placement as it now is.
+  sum_overflow_ = first_pass_snapshot_.sum_overflow;
+  sum_overflow_unscaled_ = first_pass_snapshot_.sum_overflow_unscaled;
+  prev_hpwl_ = first_pass_snapshot_.prev_hpwl;
+  is_overflow_stale_ = false;
+}
+
+void NesterovBase::releaseFirstPassSnapshot()
+{
+  if (io_) {
+    io_->releaseFirstPassSnapshot();
+  }
+  // Assigning an empty snapshot frees the vectors' storage.
+  first_pass_snapshot_ = FirstPassSnapshot{};
+}
