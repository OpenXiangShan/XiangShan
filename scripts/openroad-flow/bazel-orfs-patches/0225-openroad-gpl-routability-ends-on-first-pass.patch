+void NesterovPlace::saveFirstPassSnapshot(const float curA)
+{
+  first_pass_a_ = curA;
+  first_pass_wl_coef_x_ = wireLengthCoefX_;
+  first_pass_wl_coef_y_ = wireLengthCoefY_;
+  for (auto& nb : nbVec_) {
+    nb->saveFirstPassSnapshot();
+  }
+  is_first_pass_snapshot_saved_ = true;
+}
+
+void NesterovPlace::revertToFirstPassSnapshot(float& curA)
+{
+  curA = first_pass_a_;
+  wireLengthCoefX_ = first_pass_wl_coef_x_;
+  wireLengthCoefY_ = first_pass_wl_coef_y_;
+  nbc_->updateWireLengthForceWA(wireLengthCoefX_, wireLengthCoefY_);
+
+  // Each region's overflow comes back with its placement; the average is
+  // taken as updateNextIter() takes it.
+  float sum_overflow = 0;
+  float sum_overflow_unscaled = 0;
+  for (auto& nb : nbVec_) {
+    nb->revertToFirstPassSnapshot();
+    nb->resetMinSumOverflow();
+    sum_overflow += nb->getSumOverflow();
+    sum_overflow_unscaled += nb->getSumOverflowUnscaled();
+  }
+  average_overflow_ = sum_overflow / nbVec_.size();
+  average_overflow_unscaled_ = sum_overflow_unscaled / nbVec_.size();
+  overflow_update_is_stale_ = false;
+}
+
+void NesterovPlace::releaseFirstPassSnapshot()
+{
+  for (auto& nb : nbVec_) {
+    nb->releaseFirstPassSnapshot();
+  }
+  is_first_pass_snapshot_saved_ = false;
+}
