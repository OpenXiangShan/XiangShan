diff --git a/openroad/sta/power/test/power_when_output.lib b/openroad/sta/power/test/power_when_output.lib
new file mode 100644
index 0000000..0a12cbc
--- /dev/null
+++ b/openroad/sta/power/test/power_when_output.lib
@@ -0,0 +1,200 @@
+library (power_when_output) {
+  delay_model : table_lookup;
+  time_unit : "1ns";
+  voltage_unit : "1V";
+  current_unit : "1mA";
+  leakage_power_unit : "1nW";
+  capacitive_load_unit (1,ff);
+  pulling_resistance_unit : "1kohm";
+  nom_process : 1.0;
+  nom_temperature : 25.0;
+  nom_voltage : 1.1;
+  default_operating_conditions : typical;
+  operating_conditions (typical) {
+    process : 1.0;
+    temperature : 25.0;
+    voltage : 1.1;
+  }
+
+  /* Leakage states written over the input and the output, as many
+     libraries write them. Y is !A, so "A * !Y" is A. The unconditional
+     value applies only when no state is given. */
+  cell (INV_W) {
+    leakage_power () {
+      when : "A * !Y";
+      value : 1.0;
+    }
+    leakage_power () {
+      when : "!A * Y";
+      value : 3.0;
+    }
+    leakage_power () {
+      value : 2.0;
+    }
+    pin (A) {
+      direction : input;
+      capacitance : 1.0;
+    }
+    pin (Y) {
+      direction : output;
+      function : "!A";
+      timing () {
+        related_pin : "A";
+        timing_sense : negative_unate;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+    }
+  }
+
+  /* Leakage states written over the inputs only. */
+  cell (NAND2_W) {
+    leakage_power () {
+      when : "!A * !B";
+      value : 1.0;
+    }
+    leakage_power () {
+      when : "!A * B";
+      value : 2.0;
+    }
+    leakage_power () {
+      when : "A * !B";
+      value : 3.0;
+    }
+    leakage_power () {
+      when : "A * B";
+      value : 4.0;
+    }
+    pin (A) {
+      direction : input;
+      capacitance : 1.0;
+    }
+    pin (B) {
+      direction : input;
+      capacitance : 1.0;
+    }
+    pin (Y) {
+      direction : output;
+      function : "!(A * B)";
+      timing () {
+        related_pin : "A";
+        timing_sense : negative_unate;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+      timing () {
+        related_pin : "B";
+        timing_sense : negative_unate;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+    }
+  }
+
+  /* B's internal power when A1 and A2 hold Y high, written with Y. */
+  cell (AO21_W) {
+    pin (A1) {
+      direction : input;
+      capacitance : 1.0;
+    }
+    pin (A2) {
+      direction : input;
+      capacitance : 1.0;
+    }
+    pin (B) {
+      direction : input;
+      capacitance : 1.0;
+      internal_power () {
+        when : "A1 * A2 * Y";
+        rise_power (scalar) { values ("1.0"); }
+        fall_power (scalar) { values ("1.0"); }
+      }
+    }
+    pin (Y) {
+      direction : output;
+      function : "(A1 * A2) + B";
+      timing () {
+        related_pin : "A1";
+        timing_sense : positive_unate;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+      timing () {
+        related_pin : "A2";
+        timing_sense : positive_unate;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+      timing () {
+        related_pin : "B";
+        timing_sense : positive_unate;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+    }
+  }
+
+  /* Leakage states over the data input and the state output QN. QN is
+     the flop's state, not a function of D, and keeps its own duty. */
+  cell (DFF_W) {
+    ff (IQ, IQN) {
+      next_state : "D";
+      clocked_on : "CK";
+    }
+    leakage_power () {
+      when : "D * QN";
+      value : 1.0;
+    }
+    leakage_power () {
+      when : "D * !QN";
+      value : 2.0;
+    }
+    leakage_power () {
+      when : "!D * QN";
+      value : 3.0;
+    }
+    leakage_power () {
+      when : "!D * !QN";
+      value : 4.0;
+    }
+    pin (D) {
+      direction : input;
+      capacitance : 1.0;
+      timing () {
+        related_pin : "CK";
+        timing_type : setup_rising;
+        rise_constraint (scalar) { values ("0.01"); }
+        fall_constraint (scalar) { values ("0.01"); }
+      }
+    }
+    pin (CK) {
+      direction : input;
+      capacitance : 1.0;
+      clock : true;
+    }
+    pin (QN) {
+      direction : output;
+      function : "IQN";
+      timing () {
+        related_pin : "CK";
+        timing_type : rising_edge;
+        cell_rise (scalar) { values ("0.05"); }
+        cell_fall (scalar) { values ("0.05"); }
+        rise_transition (scalar) { values ("0.02"); }
+        fall_transition (scalar) { values ("0.02"); }
+      }
+    }
+  }
+}
