diff --git a/openroad/sta/power/Power.cc b/openroad/sta/power/Power.cc
index 96581c6..8e570a4 100644
--- a/openroad/sta/power/Power.cc
+++ b/openroad/sta/power/Power.cc
@@ -846,7 +846,9 @@ Power::evalDiffDuty(FuncExpr *expr,
   Cudd_Ref(diff);
   // Weight state dependent internal power groups by P(when).
   if (when) {
-    DdNode *when_bdd = bdd_.funcBdd(when);
+    DdNode *when_bdd = whenOutputsBdd(when);
+    if (when_bdd == nullptr)
+      when_bdd = bdd_.funcBdd(when);
     DdNode *diff_when = Cudd_bddAnd(bdd_.cuddMgr(), diff, when_bdd);
     Cudd_Ref(diff_when);
     Cudd_RecursiveDeref(bdd_.cuddMgr(), when_bdd);
@@ -861,6 +863,68 @@ Power::evalDiffDuty(FuncExpr *expr,
   return duty;
 }
 
+float
+Power::evalWhenDuty(FuncExpr *when,
+                    const Instance *inst)
+{
+  DdNode *bdd = whenOutputsBdd(when);
+  if (bdd == nullptr)
+    return evalActivity(when, inst).duty();
+  float duty = evalBddDuty(bdd, inst);
+  Cudd_RecursiveDeref(bdd_.cuddMgr(), bdd);
+  bdd_.clearVarMap();
+  return duty;
+}
+
+// A combinational output is a function of the inputs, not a variable
+// independent of them: weighting the Y of an inverter's "A * !Y" by
+// its own duty finds d^2 instead of d.
+DdNode *
+Power::whenOutputsBdd(const FuncExpr *when)
+{
+  LibertyPortSet when_ports = when->ports();
+  LibertyPortSeq outputs;
+  for (LibertyPort *port : sortByName(&when_ports)) {
+    if (isCombinationalOutput(port))
+      outputs.push_back(port);
+    else if (!port->direction()->isInput())
+      return nullptr;
+  }
+  if (outputs.empty())
+    return nullptr;
+  DdManager *cudd_mgr = bdd_.cuddMgr();
+  DdNode *bdd = bdd_.funcBdd(when);
+  for (LibertyPort *output : outputs) {
+    unsigned var_index = Cudd_NodeReadIndex(bdd_.findNode(output));
+    DdNode *func_bdd = bdd_.funcBdd(output->function());
+    DdNode *composed = Cudd_bddCompose(cudd_mgr, bdd, func_bdd, var_index);
+    Cudd_Ref(composed);
+    Cudd_RecursiveDeref(cudd_mgr, func_bdd);
+    Cudd_RecursiveDeref(cudd_mgr, bdd);
+    bdd = composed;
+  }
+  return bdd;
+}
+
+bool
+Power::isCombinationalOutput(const LibertyPort *port) const
+{
+  const LibertyCell *cell = port->libertyCell();
+  const FuncExpr *func = port->function();
+  if (port->direction()->isOutput()
+      && func
+      && port->tristateEnable() == nullptr
+      && !cell->isSequential()
+      && !cell->isClockGate()) {
+    for (const LibertyPort *func_port : func->ports()) {
+      if (!func_port->direction()->isInput())
+        return false;
+    }
+    return true;
+  }
+  return false;
+}
+
 // As suggested by
 // https://stackoverflow.com/questions/63326728/cudd-printminterm-accessing-the-individual-minterms-in-the-sum-of-products
 float
@@ -1466,7 +1530,7 @@ Power::findInputInternalPower(const Pin *pin,
         FuncExpr *when = pwr->when();
         // Weight each group by P(when).
         if (when)
-          duty = evalActivity(when, inst).duty();
+          duty = evalWhenDuty(when, inst);
         float port_internal = energy * duty * activity.density();
         debugPrint(debug_, "power", 2, " {} {}  {:.2f}  {:.2f} {:9.2e} {:9.2e} {}",
                    port->name(), when ? when->to_string() : "",
@@ -1620,7 +1684,7 @@ Power::findInputDuty(const Instance *inst,
         return duty;
       }
       else if (when)
-        return evalActivity(when, inst).duty();
+        return evalWhenDuty(when, inst);
       else if (scene_->mode()->clkNetwork()->isClock(from_vertex->pin()))
         return 0.5;
       return 0.5;
@@ -1740,8 +1804,7 @@ Power::findLeakagePower(const Instance *inst,
           sum.cond_true_exists = true;
         }
         else {
-          PwrActivity cond_activity = evalActivity(when, inst);
-          float cond_duty = cond_activity.duty();
+          float cond_duty = evalWhenDuty(when, inst);
           debugPrint(debug_, "power", 2, "leakage {} {} {} {:.3e} * {:.2f}",
                      cell->name(),
                      pg_name,
