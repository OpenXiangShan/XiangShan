diff --git a/openroad/sta/power/test/power_when_output.tcl b/openroad/sta/power/test/power_when_output.tcl
new file mode 100644
index 0000000..ffa1820
--- /dev/null
+++ b/openroad/sta/power/test/power_when_output.tcl
@@ -0,0 +1,49 @@
+# Leakage and internal power when conditions that name a combinational
+# output. The output is a function of the inputs, so u_inv's leakage at
+# input duty d is d * L(A=1) + (1 - d) * L(A=0), and u_ao's "A1 * A2 * Y"
+# holds with probability P(A1) * P(A2). Conditions over inputs only
+# (u_nand) and over a flop's state (u_ff) are evaluated as before.
+read_liberty power_when_output.lib
+read_verilog power_when_output.v
+link_design top
+create_clock -name clk -period 10 [get_ports clk]
+set_input_delay 0 -clock clk [delete_from_list [all_inputs] [get_ports clk]]
+
+proc check { what reported expected } {
+  if { abs($reported - $expected) <= 1e-6 * abs($expected) + 1e-15 } {
+    set result "ok"
+  } else {
+    set result "wrong"
+  }
+  puts [format "%s %.6e expected %.6e %s" $what $reported $expected $result]
+}
+
+proc inst_power { inst } {
+  return [sta::instance_power [get_cells $inst] [sta::cmd_scene]]
+}
+
+set_power_activity -input_ports b -density 0.1 -duty 0.5
+set_power_activity -input_ports d -density 0.1 -duty 0.3
+foreach duty {0 0.1 0.5 0.9 1} {
+  set_power_activity -input_ports {a c} -density 0 -duty $duty
+  lassign [inst_power u_inv] internal switching leakage
+  check "u_inv duty $duty leakage" $leakage \
+    [expr ($duty * 1.0 + (1.0 - $duty) * 3.0) * 1e-9]
+  lassign [inst_power u_nand] internal switching leakage
+  set db 0.5
+  check "u_nand duty $duty leakage" $leakage \
+    [expr ((1 - $duty) * (1 - $db) * 1.0 + (1 - $duty) * $db * 2.0 \
+             + $duty * (1 - $db) * 3.0 + $duty * $db * 4.0) * 1e-9]
+  # 1 fJ per B transition, 0.1 transitions/ns.
+  lassign [inst_power u_ao] internal
+  check "u_ao duty $duty internal" $internal \
+    [expr 1e-15 * 0.1e9 * $duty * $duty]
+}
+# QN is the state D was clocked into, so its duty is 1 - P(D) and it is
+# independent of D's present value.
+lassign [inst_power u_ff] internal switching leakage
+set dd 0.3
+set dqn [expr 1 - $dd]
+check "u_ff leakage" $leakage \
+  [expr ($dd * $dqn * 1.0 + $dd * (1 - $dqn) * 2.0 \
+           + (1 - $dd) * $dqn * 3.0 + (1 - $dd) * (1 - $dqn) * 4.0) * 1e-9]
diff --git a/openroad/sta/power/test/power_when_output.v b/openroad/sta/power/test/power_when_output.v
new file mode 100644
index 0000000..523de0e
--- /dev/null
+++ b/openroad/sta/power/test/power_when_output.v
@@ -0,0 +1,9 @@
+module top (clk, a, b, c, d, y1, y2, y3, q);
+  input clk, a, b, c, d;
+  output y1, y2, y3, q;
+
+  INV_W u_inv (.A(a), .Y(y1));
+  NAND2_W u_nand (.A(a), .B(b), .Y(y2));
+  AO21_W u_ao (.A1(a), .A2(c), .B(b), .Y(y3));
+  DFF_W u_ff (.CK(clk), .D(d), .QN(q));
+endmodule
