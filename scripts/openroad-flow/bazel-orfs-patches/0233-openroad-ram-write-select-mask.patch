diff --git a/openroad/ram/test/write_select_mask_asap7.tcl b/openroad/ram/test/write_select_mask_asap7.tcl
new file mode 100644
index 0000000000..0b7a02a587
--- /dev/null
+++ b/openroad/ram/test/write_select_mask_asap7.tcl
@@ -0,0 +1,45 @@
+# -write_select mask: a write port names the words it writes by a mask, a
+# bit a word; each word's select is its bit, through its select buffer,
+# with no decoder, and one write may write many words. Where both ports
+# write a word in a cycle the last port's data is kept.
+
+source "helpers.tcl"
+source "ram_sim.tcl"
+source "routed.tcl"
+
+routed::read_asap7
+
+set behavioral [make_result_file write_select_mask.v]
+generate_ram {*}$routed::asap7 \
+  -mask_size 8 -word_size 8 -num_words 16 -r_ports 2 -w_ports 2 \
+  -storage_cell DFFHQNx1_ASAP7_75t_R -decoder word -write_select mask \
+  -write_behavioral_verilog $behavioral
+routed::check
+
+set block [ord::get_db_block]
+foreach port {wsel0 wsel1} {
+  ram_sim::check { [$block findBTerm "$port\[15\]"] ne "NULL" } \
+    "no $port\[15\]"
+}
+ram_sim::check { [$block findBTerm "addr_w0\[0\]"] eq "NULL" } \
+  "a mask port has an address"
+foreach inst [$block getInsts] {
+  set name [$inst getName]
+  ram_sim::check { ![string match "decoder_p0*" $name] && ![string match "decoder_p1*" $name] } \
+    "$name: a mask port has a decoder"
+}
+
+set f [open $behavioral r]
+set model [read $f]
+close $f
+ram_sim::check { [string first {we1[i] && wsel1[j]} $model] >= 0 } \
+  "the behavioral model does not write by wsel1"
+
+ram_sim::load
+ram_sim::exercise {
+  words 16 bits 8 select mask cycles 300
+  writes {{wsel0 D0 {we0[0]}} {wsel1 D1 {we1[0]}}}
+  reads {{addr_r0 Q0} {addr_r1 Q1}}
+}
+
+puts "pass"
