         addr_flop_out_[p][i] = inv_addr_nets[p][i]
             = makeNet(port_prefix, fmt::format("inv_addr[{}]", i));
@@ -2933,6 +2952,10 @@ void RamGen::generate(const int mask_size,
             literals.clear();  // a word of another bank: no decoder
