+                                       address_width - 1,
+                                       wbus("addr_w", w));
     }
   }
   for (int i = 0; i < r_ports; i++) {
@@ -4435,41 +4476,60 @@ void RamGen::writeBehavioralVerilog(const std::string& filename,
   std::string data_declarations;
   std::string enable_declarations;
   std::string write_logic;
+  // -write_select mask: every word j whose mask bit is set
   for (int w = 0; w < num_write; ++w) {
     const std::string write_addr
-        = rw_ports > 0 ? std::string("addr_rw") : wbus("addr_w", w);
+        = write_mask_  ? std::string("j")
+          : rw_ports > 0 ? std::string("addr_rw")
+                         : wbus("addr_w", w);
+    // whether port v writes the word this port does
+    auto writes_word = [&](const int v) {
+      return write_mask_ ? fmt::format("{}[j]", wbus("wsel", v))
+                         : fmt::format("{} == {}", wbus("addr_w", v), write_addr);
+    };
     std::string write_data
         = fmt::format("{}[i*{} +:{}]", wbus("D", w), mask_size, mask_size);
     for (int v = 0; write_or_ && v < w; ++v) {
-      write_data += fmt::format(
-          "\n          | ({{{}{{{}[i] && {} == {}}}}} & {}[i*{} +:{}])",
-          mask_size,
-          wbus("we", v),
-          wbus("addr_w", v),
-          write_addr,
-          wbus("D", v),
-          mask_size,
-          mask_size);
+      write_data
+          += fmt::format("\n          | ({{{}{{{}[i] && {}}}}} & {}[i*{} +:{}])",
+                         mask_size,
+                         wbus("we", v),
+                         writes_word(v),
+                         wbus("D", v),
+                         mask_size,
+                         mask_size);
     }
     data_declarations
         += fmt::format("  input [{}:0] {};\n", word_size_bit - 1, wbus("D", w));
     enable_declarations += fmt::format(
         "  input [{}:0] {};\n", slices_per_word - 1, wbus("we", w));
-    write_logic += fmt::format(
+    std::string condition = wbus("we", w) + "[i]";
+    if (write_mask_) {
+      condition += " && " + writes_word(w);
+    }
+    if (zero_word_ >= 0) {
+      condition += fmt::format(" && {} != {}", write_addr, zero_word_);
+    }
+    std::string port_logic = fmt::format(
         R"(    for (i = 0; i < {}; i = i + 1) begin
-      if ({}[i]{}) begin
+      if ({}) begin
         mem[{}][i*{} +:{}] <= {};
       end
     end
 )",
         slices_per_word,
-        wbus("we", w),
-        zero_word_ >= 0 ? fmt::format(" && {} != {}", write_addr, zero_word_)
-                        : std::string(),
+        condition,
         write_addr,
         mask_size,
         mask_size,
         write_data);
+    if (write_mask_) {
+      port_logic = fmt::format(
+          "    for (j = 0; j < {}; j = j + 1) begin\n{}    end\n",
+          num_words,
+          port_logic);
+    }
+    write_logic += port_logic;
   }
 
   std::string reset_declaration;
@@ -4505,7 +4565,7 @@ void RamGen::writeBehavioralVerilog(const std::string& filename,
   reg [{}:0] mem[0:{}];
 
   // write logic
-  integer i;
+  integer i;{}
 {}{}  end
 
   // read logic
@@ -4521,6 +4581,7 @@ endmodule
                                          enable_declarations,
                                          word_size_bit - 1,
                                          num_words - 1,
+                                         write_mask_ ? "\n  integer j;" : "",
                                          always_head,
                                          write_logic,
                                          read_port_logic);
