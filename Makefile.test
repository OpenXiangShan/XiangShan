# only generate a small module: example
verilog-decode:
	mill -i 'xiangshan[$(CHISEL_VERSION)].test.runMain' xiangshan.DecodeMain -td build --output-file DecodeUnit.v

# chiseltest
# autorun all the chiselTest case
test:
	mill -i 'xiangshan[$(CHISEL_VERSION)].test.test'

# only run DecodeUnitTest
test-DecodeUnit:
	mill -i 'xiangshan[$(CHISEL_VERSION)].test.testOnly' xiangshan.DecodeUnitTest
