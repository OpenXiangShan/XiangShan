#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(git rev-parse --show-toplevel)"
cd "${REPO_DIR}"

scala_files="$(git diff --cached --name-only --diff-filter=ACMR -- src/main/scala)"

if [[ -n "${scala_files}" ]]; then
  echo "ERROR: commits that modify src/main/scala are prohibited in this worktree." >&2
  echo "${scala_files}" >&2
  exit 1
fi

TESTPOINT_CSV="src/test/python/Frontend/docs/02_testpoint/Frontend_testpoint_0525_coverage_backannotated.csv"

if git diff --cached --name-only --diff-filter=ACMR -- "${TESTPOINT_CSV}" | grep -Fxq "${TESTPOINT_CSV}"; then
  echo "[testpoint-csv-guard] checking staged CSV record layout"
  python src/test/python/Frontend/tests/py/environment/test_testpoint_csv_contract.py --staged
fi

if ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '^(src/test/python/Frontend/|\.githooks/pre-commit$)'; then
  exit 0
fi

echo "[frontend-change-guard] running fast frontend smoke suite"
python src/test/python/Frontend/change_guard.py
