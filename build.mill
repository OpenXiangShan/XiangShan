package build

import $ivy.`de.tototec::de.tobiasroeser.mill.vcs.version::0.4.0`
import $ivy.`cc.xiangshan::chisel:7.16.0-xiangshan-2`
import $ivy.`cc.xiangshan::firtool-resolver:2.2.0`
import de.tobiasroeser.mill.vcs.version.VcsVersion
import java.io.BufferedReader
import java.io.InputStreamReader
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter
import java.util.Locale
import mill._
import mill.scalalib._
import mill.scalalib.scalafmt.ScalafmtModule
import os.Path

val defaultScalaVersion = "2.13.18"

val pwd = os.Path(sys.env("MILL_WORKSPACE_ROOT"))

object ivys {
  val scala = defaultScalaVersion

  // The first entry is the default variant used by the Makefile.
  val chiselKeys = Seq("xiangshan", "upstream")

  val chiselCrossVersions = Map(
    "xiangshan" -> (
      mvn"cc.xiangshan::chisel:7.16.0-xiangshan-2",
      mvn"cc.xiangshan:::chisel-plugin:7.16.0-xiangshan-2"
    ),
    "upstream" -> (
      mvn"org.chipsalliance::chisel:7.16.0",
      mvn"org.chipsalliance:::chisel-plugin:7.16.0"
    )
  )
}

trait ChiselModule extends SbtModule with ScalafmtModule with Cross.Module[String] {
  def scalaVersion: T[String] = ivys.scala

  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations", "-Ytasty-reader")

  def ivyDeps: T[Agg[Dep]] = Agg(
    ivys.chiselCrossVersions(crossValue)._1,
    mvn"com.lihaoyi::sourcecode:0.4.4",
  )

  def scalacPluginIvyDeps: T[Agg[Dep]] = Agg(ivys.chiselCrossVersions(crossValue)._2)

  def resolveFirtoolDeps = T {
    firtoolresolver.Resolve(chisel3.BuildInfo.firtoolVersion.get, true) match {
      case Right(bin) => bin.path.getAbsolutePath
      case Left(err)  => err
    }
  }
}

trait RocketChip extends ChiselModule {
  override def millSourcePath: Path = pwd / "rocket-chip"

  object macros extends ScalaModule {
    def scalaVersion: T[String] = ivys.scala

    def ivyDeps: T[Agg[Dep]] = Agg(mvn"org.scala-lang:scala-reflect:${ivys.scala}")
  }

  trait Hardfloat extends ChiselModule {
    override def millSourcePath: Path = pwd / "rocket-chip" / "hardfloat" / "hardfloat"
  }

  object hardfloat extends Cross[Hardfloat](ivys.chiselKeys)

  object cde extends ScalaModule {
    def scalaVersion: T[String] = ivys.scala

    override def millSourcePath: Path = pwd / "rocket-chip" / "cde" / "cde"
  }

  def mainClass = Some("freechips.rocketchip.diplomacy.Main")

  def moduleDeps = Seq(macros, hardfloat(crossValue), cde)

  def ivyDeps: T[Agg[Dep]] =
    super.ivyDeps() ++ Agg(mvn"com.lihaoyi::mainargs:0.7.7", mvn"org.json4s::json4s-jackson:4.0.7")
}

object `rocket-chip` extends Cross[RocketChip](ivys.chiselKeys)

